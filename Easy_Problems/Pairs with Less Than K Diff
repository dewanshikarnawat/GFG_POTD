//Problem: Pairs with Less Than K Diff
//Topic: Sorting + Two Pointers (Sliding Window)
//Pattern: Easy

class Solution {
  public:
    int countPairs(vector<int>& arr, int k) {
        sort(arr.begin(), arr.end());

        int n = arr.size();
        int left = 0;
        int right = 1;
        int ans = 0;

        while (right < n) {
            if (arr[right] - arr[left] < k) {
                ans += (right - left);
                right++;
            } else {
                left++;
            }
        }

        return ans;
        
    }
};
